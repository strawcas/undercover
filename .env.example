OPENROUTER_API_KEY=
# Choose openrouter (default) or ollama.
# MODEL_PROVIDER=openrouter
# OpenRouter: optional override; otherwise uses openai/gpt-6-luna.
# MODEL_NAME=openrouter/free
# Ollama: set MODEL_PROVIDER=ollama and MODEL_NAME to a downloaded tool-calling model.
# MODEL_NAME=qwen3:8b
# Ollama uses its native API; do not append /v1.
# OLLAMA_BASE_URL=http://localhost:11434
# Optional local settings; defaults are shown.
# The standalone agent starts its local HTTP backend at this address.
# UNDERCOVER_BACKEND_URL=http://localhost:8000
# UNDERCOVER_DB_PATH=undercover.db
