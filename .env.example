OPENROUTER_API_KEY=
# Choose openrouter (default) or ollama.
# MODEL_PROVIDER=openrouter
# OpenRouter: optional override; otherwise uses deepseek/deepseek-v4.1-flash.
# MODEL_NAME=openrouter/free
# Ollama: set MODEL_PROVIDER=ollama and MODEL_NAME to a downloaded tool-calling model.
# MODEL_NAME=qwen3:8b
# Ollama uses its native API; do not append /v1.
# OLLAMA_BASE_URL=http://localhost:11434
# Context tokens for claim evidence, policy wording and tool history.
# OLLAMA_NUM_CTX=16384
# Hosted storage: paste the session pooler URL from the lab, using port 5432.
# Leave DATABASE_URL absent for SQLite; a configured Postgres failure never falls back.
# DATABASE_URL=postgresql://postgres.PROJECT:ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres
# All product and checkpoint tables use the undercover schema.
# Optional tracing; omit both keys to disable export locally.
# LANGFUSE_PUBLIC_KEY=your-public-key
# LANGFUSE_SECRET_KEY=your-secret-key
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional local settings; defaults are shown.
# CLI commands attach to matching services or start temporary local children.
# UNDERCOVER_BACKEND_URL=http://localhost:8000
# UNDERCOVER_AGENT=http://127.0.0.1:8002
# UNDERCOVER_DB_PATH=undercover.db
# Start assessments explicitly with uv run -m agent; add --cap 5 for a trial.
# Restart the agent service after changing provider/model/database settings.
